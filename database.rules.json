{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "revealed": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'st28474101@gmail.com'",
        "$photoId": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      },
      "answerImages": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'st28474101@gmail.com'",
        "$photoId": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 150000"
        }
      },
      "hiddenQuestions": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'st28474101@gmail.com'",
        "$photoId": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "private": {
      "answerImages": {
        ".read": "auth != null && auth.token.email === 'st28474101@gmail.com'",
        ".write": "auth != null && auth.token.email === 'st28474101@gmail.com'",
        "$photoId": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 150000"
        }
